# Copy this file to .env and fill values.

NODE_ENV=development
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN_SECONDS=43200
SUPER_ADMIN_SECRET=replace_with_strong_super_admin_secret

# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token
# USE_TURSO=true
# In development, local SQLite is used unless USE_TURSO=true.

EMAIL_VERIFICATION_EXPIRES_HOURS=24

# smtp | resend | sendgrid | console
EMAIL_PROVIDER=resend
EMAIL_FROM=Tasker <onboarding@resend.dev>

# SMTP
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxx
